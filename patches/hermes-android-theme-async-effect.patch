@@ -463 +463,6 @@ export function ThemeProvider({ children }: { children: ReactNode }) {
-  useEffect(() => syncNativeTheme(mode, renderedMode), [mode, renderedMode])
+  // Effects may return a cleanup function only. The bridge method is async, so
+  // returning it directly makes React treat its Promise as a cleanup callback;
+  // the next appearance change then crashes during passive-effect teardown.
+  useEffect(() => {
+    void syncNativeTheme(mode, renderedMode)
+  }, [mode, renderedMode])
